{
  "expo": {
    "name": "CraftFlow",
    "slug": "CraftFlow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.juxnlx.craftflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#BE6B4F"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CraftFlow necesita acceso a tus fotos para elegir imágenes de materiales, proyectos y de tu perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7223e948-414a-40a5-8889-d7cc6b63b319"
      }
    }
  }
}
