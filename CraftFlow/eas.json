{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "CLOUDINARY_CLOUD_NAME": "dtpsgoaym",
        "CLOUDINARY_UPLOAD_PRESET": "craftflow_unsigned",
        "CLOUDINARY_FOLDER": "craftflow"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "CLOUDINARY_CLOUD_NAME": "dtpsgoaym",
        "CLOUDINARY_UPLOAD_PRESET": "craftflow_unsigned",
        "CLOUDINARY_FOLDER": "craftflow"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
